    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
